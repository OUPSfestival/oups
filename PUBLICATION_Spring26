
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PDF Viewer</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f1f1f1;
        }

        .toolbar {
            height: 55px;
            background: #222;
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
        }

        .toolbar a {
            color: white;
            text-decoration: none;
            background: #444;
            padding: 9px 15px;
            border-radius: 4px;
        }

        .pdf-container {
            height: calc(100vh - 55px);
            width: 100%;
        }

        .pdf-container iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
    </style>
</head>

<body>

    <div class="toolbar">
        <span>PDF Document</span>
        <a href="OUPS!_Publication_Spring26_Web.pdf" download>Download PDF</a>
    </div>

    <div class="pdf-container">
        <iframe src="document.pdf"></iframe>
    </div>

</body>
</html>
